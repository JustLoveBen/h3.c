{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JustLoveBen/h3.c/tests/fixtures/fewstep_contracts.schema.json",
  "title": "h3 fewstep contracts",
  "type": "object",
  "required": ["schema_version", "source", "forbidden_speed_presets", "contracts"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "forbidden_speed_presets": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "notes": { "type": "object" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "nfe", "steps", "sampler", "video_shift", "audio_shift",
          "cfg", "want_lcm_renoise", "lora_required", "sigma_schedule"
        ],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "enum": ["pdmd4", "pdmd2", "dmad4"] },
          "nfe": { "type": "integer", "minimum": 1 },
          "steps": { "type": "integer", "minimum": 1 },
          "sampler": {
            "type": "string",
            "enum": ["velocity_euler", "lcm_renoise"]
          },
          "sampler_aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "video_shift": { "type": "number" },
          "audio_shift": { "type": "number" },
          "audio_shift_alt": {
            "type": "array",
            "items": { "type": "number" }
          },
          "cfg": { "type": "number" },
          "want_lcm_renoise": { "type": "boolean" },
          "lora_required": { "type": "boolean" },
          "sigma_schedule": { "type": "string" }
        }
      }
    }
  }
}
